\ ===========================================================================
\ Step8_7.mpc  --  STEP 8.7 SMOKE TEST MSN
\ ---------------------------------------------------------------------------
\ Pairs with smoke_test/step_8_7/BACKPROC.PAS .  See that file for the
\ deployment + test procedure.
\
\ Purpose: prove that BackProc1 can
\   (a) actually open  C:\MED-PC\CoasterChase\trigger\test.req  (perms OK),
\   (b) parse key=value lines correctly,
\   (c) hand the parsed values back to MSN via BigArr[Vars[..]].StartOffset.
\
\ (Directory enumeration with FindFirst was deferred -- see BACKPROC.PAS
\  history note.  Step 8.7 per the plan only needs the fixed-filename
\  "test.req" path, which doesn't require FindFirst.)
\
\ This MSN does NOT drive the feeder, NOT write .ack files, NOT run a
\ dispense state machine.  It just polls and displays.
\
\ VARIABLES:
\   D = BKGRND handshake (Pascal sets 1, MSN clears 0)
\   Q = "a .req file was consumed this pass" (Pascal sets 1, MSN clears 0)
\   R = last parsed reward_size           (set by Pascal)
\   S = last parsed seq                   (set by Pascal)
\   C = total BKGRND 1 calls this session (MSN counter)
\   F = total .req files successfully parsed (MSN counter)
\   I = total polls with no .req present   (MSN counter)
\
\ SHOW fields:
\   1 "Files read F"           -- should increment each time you drop a .req
\   2 "Last reward_size R"     -- mirrors the reward_size in the most recent .req
\   3 "Last seq S"             -- mirrors the seq in the most recent .req
\   4 "Idle polls I"           -- ticks roughly twice per second when idle
\
\ PASS criterion:
\   Drop one  test.req  (Notepad, ANSI/UTF-8 no BOM) into
\   C:\MED-PC\CoasterChase\trigger\ .  Within ~0.5 s:
\     - the file disappears from disk (Pascal deleted it)
\     - F increments by 1
\     - R and S update to the parsed reward_size and seq
\   Repeat with new test.req files containing different values to confirm
\   R and S update each time.  After N drops, F = N and I keeps growing.
\
\ Stop:  STOP button for Box 1, or  STS;1  in the terminal.
\ ===========================================================================


S.S.1,        \ ---- poll BKGRND 1 every 0.5 s -------------------------
S1,
   #START: SET D = 0; SET Q = 0; SET R = 0; SET S = 0;
           SET C = 0; SET F = 0; SET I = 0 ---> S2

S2,           \ idle 0.5 s, then call BKGRND 1
   0.5": SET D = 0; BKGRND 1 ---> S3

S3,           \ wait for the handshake (Pascal sets D = 1)
   0.01": IF D = 1 [] ---> S4

S4,           \ did BackProc1 consume a file?
   0.01": IF Q = 1 [@got, @none]
      @got:  ADD C; ADD F; SET Q = 0;
             SHOW 1, Files read F, F, 2, Last reward_size R, R, 3, Last seq S, S ---> S2
      @none: ADD C; ADD I;
             SHOW 4, Idle polls I, I ---> S2
